////////////////////////////////////////////////////////////////////////////// 
// var.h 
// Заголовковий файл — оголошення глобальних змінних у просторі імен nsVar 
 
#pragma once 
 
namespace nsVar { 
    extern int n;                                 // лічильник просумованих доданків 
    extern double x, x_p, x_k, dx, e, a, s;       // аргумент, межі, крок, точність, доданок, сума 
}; 
 
////////////////////////////////////////////////////////////////////////////// 
// var.cpp 
// Файл реалізації — визначення глобальних змінних 
 
#include "var.h" 
 
namespace nsVar { 
    int n; 
    double x, x_p, x_k, dx, e, a, s; 
}; 
 
////////////////////////////////////////////////////////////////////////////// 
// dod.h 
// Заголовковий файл — оголошення функції обчислення доданка 
 
#pragma once 
 
namespace nsDod { 
    void dod(); // прототип процедури обчислення чергового доданка ряду 
}; 
 
////////////////////////////////////////////////////////////////////////////// 
// dod.cpp 
// Файл реалізації функції обчислення доданка за рекурентним співвідношенням 
 
#include "dod.h" 
#include "var.h" 
 
using namespace nsVar; 
 
void nsDod::dod() { 
    // Доданок домножується на коефіцієнт рекурентності для ряду Arcth(x) 
    a *= (2.0 * n - 1) / ((2.0 * n + 1) * x * x); 
} 
 
////////////////////////////////////////////////////////////////////////////// 
// sum.h 
// Заголовковий файл — оголошення функції обчислення суми ряду 
 
#pragma once 
 
namespace nsSum { 
    void sum(); // прототип процедури обчислення суми ряду Тейлора 
}; 
 
////////////////////////////////////////////////////////////////////////////// 
// sum.cpp 
// Файл реалізації функції обчислення суми ряду 
 
#include <cmath> 
#include "dod.h" 
#include "sum.h" 
#include "var.h" 
 
using namespace nsDod; 
using namespace nsVar; 
 
void nsSum::sum() { 
    n = 0;          // початкове значення лічильника доданків 
    a = 1.0 / x;    // перший доданок ряду при n = 0 
    s = a;          // початкове значення суми 
 
    do { 
        n++; 
        dod();      // виклик процедури обчислення наступного доданка 
        s += a;     // накопичення суми ряду 
    } while (fabs(a) > e); // умова досягнення заданої точності 
} 
 
////////////////////////////////////////////////////////////////////////////// 
// Lab_9_1.cpp 
// Головний файл проєкту — введення даних, табулювання та виведення таблиці 
 
#include <iostream> 
#include <cmath> 
#include <iomanip> 
 
#include "dod.h" 
#include "sum.h" 
#include "var.h" 
 
using namespace std; 
using namespace nsDod; 
using namespace nsSum; 
using namespace nsVar; 
 
int main() { 
    // Введення параметрів табулювання з клавіатури 
    cout << "x_p = "; cin >> x_p; 
    cout << "x_k = "; cin >> x_k; 
    cout << "dx  = "; cin >> dx; 
    cout << "eps = "; cin >> e; 
    cout << endl; 
 
    // Виведення заголовка та шапки таблиці 
    cout << "Table of values Arcth(x)" << endl; 
    cout << "---------------------------------------------------------" << endl; 
    cout << "|" << setw(10) << "x" << " |" 
        << setw(15) << "Arcth(x)" << " |" 
        << setw(15) << "S (sum)" << " |" 
        << setw(8) << "n" << " |" << endl; 
    cout << "---------------------------------------------------------" << endl; 
 
    // Цикл табулювання функції на інтервалі [x_p; x_k] з кроком dx 
    x = x_p; 
    while (x <= x_k + dx / 2.0) { 
        if (fabs(x) <= 1.0) { 
            // Перевірка області збіжності ряду (|x| > 1) 
            cout << "|" << setw(10) << fixed << setprecision(4) << x << " |" 
                << setw(39) << " Error: |x| must be > 1 " << "|" << endl; 
        } 
        else { 
            sum(); // виклик процедури обчислення суми ряду 
            double exact = 0.5 * log((x + 1.0) / (x - 1.0)); // еталонне значення Arcth(x) 
 
            // Форматований вивід рядка таблиці 
            cout << "|" << setw(10) << fixed << setprecision(4) << x << " |" 
                << setw(15) << setprecision(6) << exact << " |" 
                << setw(15) << setprecision(6) << s << " |" 
                << setw(8) << n << " |" << endl; 
        } 
        x += dx; 
    } 
    cout << "---------------------------------------------------------" << endl; 
 
    return 0; 
} 
 
